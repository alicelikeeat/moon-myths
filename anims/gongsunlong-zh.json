{"id":"gongsunlong-zh","scenes":[{"anchor":"公孫龍子","title":"公孫龍子","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.1,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.52,"label":"公孫龍子","color":"primary","size":15},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"公孫龍子","color":"gold","size":17,"at":1}],"beats":[{"headline":"公孫龍子","dur":6},{"headline":"要点","dur":6.5,"hide":["t0_0","q0"]}],"score":0},{"anchor":"跡府第一","title":"跡府第一","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.1,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.52,"label":"跡府第一","color":"primary","size":15},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"跡府第一","color":"gold","size":17,"at":1}],"beats":[{"headline":"跡府第一","dur":6},{"headline":"要点","dur":6.5,"hide":["t0_0","q0"]}],"score":14},{"anchor":"公孫龍六國時辯士也疾名實之散","title":"公孫龍六國時辯士也疾","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.32,"label":"公孫龍六國時辯士也疾名實之散亂因資","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"材之所長為守白之論假物取譬以守白辯","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.52,"label":"謂白馬為非馬也白馬為非馬者言白所以","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"名色言馬所以名形也色非形非色也夫言","color":"primary","size":15},{"id":"t0_4","kind":"text","x":0.5,"y":0.72,"label":"色則形不當與言形則色不宜從今合以為","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.32,"label":"物非也如求白馬於廐中無有而有驪色之","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"馬然不可以應有白馬也不可以應有白馬","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.52,"label":"則所求之馬亡矣亡則白馬竟非馬欲推是","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"辨以正名實而化天下焉龍與孔穿㑹趙平","color":"primary","size":15,"at":1},{"id":"t1_4","kind":"text","x":0.5,"y":0.72,"label":"原君家穿曰素聞先生髙誼願為弟子久但","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.32,"label":"不取先生以白馬為非馬耳請去此術則穿","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"請為弟子龍曰先生之言悖龍之所以為名","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.52,"label":"者乃以白馬之論爾今使龍去之則無以教","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"焉且欲師之者以智與學不如也今使龍去","color":"primary","size":15,"at":2},{"id":"t2_4","kind":"text","x":0.5,"y":0.72,"label":"之此先教而後師之也先教而後師之者悖","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.32,"label":"且白馬非馬乃仲尼之所取龍聞楚王張繁","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"弱之弓載忘歸之矢以射蛟兕於雲夢之圃","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.52,"label":"而喪其弓其左右請求之王曰止楚王遺弓","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"楚人得之又何求乎仲尼聞之曰楚王仁義","color":"primary","size":15,"at":3},{"id":"t3_4","kind":"text","x":0.5,"y":0.72,"label":"而未遂也亦曰人亡弓人得之而已何必楚","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"辨以正名實而化天下焉龍與孔穿㑹趙平","color":"gold","size":17,"at":4}],"beats":[{"headline":"公孫龍六國時辯士也疾","dur":6},{"headline":"公孫龍六國時辯士也疾","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","t0_4","q0"]},{"headline":"公孫龍六國時辯士也疾","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","t1_4","q1"]},{"headline":"公孫龍六國時辯士也疾（节选）","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","t2_4","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","t3_4","q3"]}],"score":43},{"anchor":"白馬非馬可乎曰可曰何哉曰馬者","title":"白馬非馬可乎曰可曰何","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.32,"label":"白馬非馬可乎曰可曰何哉曰馬者所以命","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"形也白者所以命色也命色者非命形也故","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.52,"label":"曰白馬非馬曰有白馬不可謂無馬也不可","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"謂無馬者非馬也有白馬為有馬白之非馬","color":"primary","size":15},{"id":"t0_4","kind":"text","x":0.5,"y":0.72,"label":"何也曰求馬黄黒馬皆可致求白馬黄黒馬","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.32,"label":"不可致使白馬乃馬也是所求一也所求一","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"者白者不異馬也所求不異如黄黒馬有可","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.52,"label":"有不可何也可與不可其相非明故黄黒馬","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"一也而可以應有馬而不可以應有白馬是","color":"primary","size":15,"at":1},{"id":"t1_4","kind":"text","x":0.5,"y":0.72,"label":"白馬之非馬審矣曰以馬之有色為非馬天","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.32,"label":"下非有無色之馬也天下無馬可乎曰馬固","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"有色故有白馬使馬無色有馬如已耳安取","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.52,"label":"白馬故白者非馬也白馬者馬與白也馬與","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"白馬也故曰白馬非馬也曰馬未與白為馬","color":"primary","size":15,"at":2},{"id":"t2_4","kind":"text","x":0.5,"y":0.72,"label":"白未與馬為白合馬與白復名白馬是相與","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.32,"label":"以不相與為名未可故曰白馬非馬未可曰","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"以有白馬為非馬謂有白馬為有黄馬可乎","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.52,"label":"曰未可曰以有馬為異有黄馬是異黄馬於","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"馬也異黄馬於馬是以黄馬為非馬以黄馬","color":"primary","size":15,"at":3},{"id":"t3_4","kind":"text","x":0.5,"y":0.72,"label":"為非馬而以白馬為有馬此飛者入池而棺","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"白馬非馬可乎曰可曰何哉曰馬者所以命","color":"gold","size":17,"at":4}],"beats":[{"headline":"白馬非馬可乎曰可曰何","dur":6},{"headline":"白馬非馬可乎曰可曰何","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","t0_4","q0"]},{"headline":"白馬非馬可乎曰可曰何","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","t1_4","q1"]},{"headline":"白馬非馬可乎曰可曰何（节选）","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","t2_4","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","t3_4","q3"]}],"score":86},{"anchor":"物莫非指而指非指天下無指物無","title":"物莫非指而指非指天下","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.37,"label":"物莫非指而指非指天下無指物無可以謂","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.47,"label":"物非指者天下而物可謂指乎指也者天下","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"之所無也物也者天下之所有也以天下之","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.67,"label":"所有為天下之所無未可天下無指而物不","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.37,"label":"可謂指也不可謂指者非指也非指者物莫","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.47,"label":"非指也天下無指而物不可謂指者非有非","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"指也非有非指者物莫非指也物莫非指者","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.67,"label":"而指非指也天下無指者生於物之各有名","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.37,"label":"不為指也不為指而謂之指是兼不為指以","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.47,"label":"有不為指之無不為指未可且指者天下之","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"所兼天下無指者物不可謂無指也不可謂","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.67,"label":"無指者非有非指也非有非指者物莫非指","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.37,"label":"使天下無物指誰徑謂非指天下無物誰徑","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.47,"label":"為指天下有指無物指誰徑謂非指徑謂無","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"物非指且夫指固自為非指奚待於物而乃","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.67,"label":"與為指","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"物莫非指而指非指天下無指物無可以謂","color":"gold","size":17,"at":4}],"beats":[{"headline":"物莫非指而指非指天下","dur":6},{"headline":"物莫非指而指非指天下","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","q0"]},{"headline":"物莫非指而指非指天下","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","q1"]},{"headline":"物莫非指而指非指天下","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","q3"]}],"score":100},{"anchor":"曰二有一乎曰二無一曰二有右乎","title":"曰二有一乎曰二無一曰","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.32,"label":"曰二有一乎曰二無一曰二有右乎曰二無","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"右曰二有左乎曰二無左曰右可謂二乎曰","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.52,"label":"不可曰左可謂二乎曰不可曰左與右可謂","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"二乎曰可曰謂變非不變可乎曰可曰右有","color":"primary","size":15},{"id":"t0_4","kind":"text","x":0.5,"y":0.72,"label":"與可謂變乎曰可曰變隻曰右曰右茍變安","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.32,"label":"可謂右茍不變安可謂變曰二茍無左又無","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"右二者左與右柰何羊合牛非馬牛合羊非","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.52,"label":"鷄曰何哉曰羊與牛唯異羊有齒牛無齒而","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"羊牛之非羊也之非牛也未可是不俱有而","color":"primary","size":15,"at":1},{"id":"t1_4","kind":"text","x":0.5,"y":0.72,"label":"或類焉羊有角牛有角牛之而羊也羊之而","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.32,"label":"牛也未可是俱有而類之不同也羊牛有角","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"馬無角馬有尾牛羊無尾故曰羊合羊非馬","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.52,"label":"也非馬者無馬也無馬者羊不二牛不二而","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"羊牛二是而羊而牛非馬可也若舉而以是","color":"primary","size":15,"at":2},{"id":"t2_4","kind":"text","x":0.5,"y":0.72,"label":"猶類之不同若左右猶是舉牛羊有毛鷄有","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.32,"label":"羽謂鷄足二數足二二而一故三謂牛羊足","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"一數足四四而一故五牛羊足五鷄足三故","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.52,"label":"曰牛合羊非鷄非有以非鷄也與馬以鷄寜","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"馬材不材其無以類審矣舉是謂亂名是狂","color":"primary","size":15,"at":3},{"id":"t3_4","kind":"text","x":0.5,"y":0.72,"label":"舉曰他辯曰青以白非黄白以青非碧曰何","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"有君臣之於國焉故強夀矣而且青驪乎白","color":"gold","size":17,"at":4}],"beats":[{"headline":"曰二有一乎曰二無一曰","dur":6},{"headline":"曰二有一乎曰二無一曰","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","t0_4","q0"]},{"headline":"曰二有一乎曰二無一曰","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","t1_4","q1"]},{"headline":"曰二有一乎曰二無一曰（节选）","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","t2_4","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","t3_4","q3"]}],"score":29},{"anchor":"堅白石三可乎曰不可曰一可乎曰","title":"堅白石三可乎曰不可曰","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.32,"label":"堅白石三可乎曰不可曰一可乎曰可曰何","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"哉曰無堅得白其舉也二無白得堅其舉也","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.52,"label":"二曰得其所白不可謂無白得其所堅不可","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"謂無堅而之石也之於然也非三也曰視不","color":"primary","size":15},{"id":"t0_4","kind":"text","x":0.5,"y":0.72,"label":"得其所堅而得其所白者無堅也拊不得其","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.32,"label":"所白而得其所堅得其堅也無白也曰天下","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"無白不可以視石天下無堅不可以謂石堅","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.52,"label":"白石不相外藏三可乎曰有自藏也非藏而","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"藏也曰其白也其堅也而石必得以相盛盈","color":"primary","size":15,"at":1},{"id":"t1_4","kind":"text","x":0.5,"y":0.72,"label":"其自藏柰何曰得其白得其堅見與不見與","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.32,"label":"不見離一一不相盈故離離也者藏也曰石","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"之白石之堅見與不見二與三若廣脩而相","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.52,"label":"盈也其非舉乎曰物白焉不定其所白物堅","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"焉不定其所堅不定者兼惡乎甚石也曰循","color":"primary","size":15,"at":2},{"id":"t2_4","kind":"text","x":0.5,"y":0.72,"label":"石非彼無石非石無所取乎白石不相離者","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.5,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.32,"label":"固乎然其無巳曰於石一也堅白二也而在","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.42000000000000004,"label":"於石故有知焉有不知焉有見焉故知與不","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.52,"label":"知相與離見與不見相與藏藏故孰謂之不","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.6200000000000001,"label":"離曰目不能堅手不能白不可謂無堅不可","color":"primary","size":15,"at":3},{"id":"t3_4","kind":"text","x":0.5,"y":0.72,"label":"謂無白其異任也其無以代也堅白域於石","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"所白而得其所堅得其堅也無白也曰天下","color":"gold","size":17,"at":4}],"beats":[{"headline":"堅白石三可乎曰不可曰","dur":6},{"headline":"堅白石三可乎曰不可曰","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","t0_4","q0"]},{"headline":"堅白石三可乎曰不可曰","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","t1_4","q1"]},{"headline":"堅白石三可乎曰不可曰（节选）","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","t2_4","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","t3_4","q3"]}],"score":57},{"anchor":"天地與其所産焉物也夫物之為物","title":"天地與其所産焉物也夫","tier":"basic","elements":[{"id":"q0","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold"},{"id":"t0_0","kind":"text","x":0.5,"y":0.37,"label":"天地與其所産焉物也夫物之為物以物其","color":"primary","size":15},{"id":"t0_1","kind":"text","x":0.5,"y":0.47,"label":"所物而不過焉實也實以實其所實不曠焉","color":"primary","size":15},{"id":"t0_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"位也出其所位非位位其所位焉正也以其","color":"primary","size":15},{"id":"t0_3","kind":"text","x":0.5,"y":0.67,"label":"所正正其所不正疑其所正其正者正其所","color":"primary","size":15},{"id":"q1","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":1},{"id":"t1_0","kind":"text","x":0.5,"y":0.37,"label":"實也正其所實者正其名也其名正則唯乎","color":"primary","size":15,"at":1},{"id":"t1_1","kind":"text","x":0.5,"y":0.47,"label":"其彼此焉謂彼而彼不唯乎彼則彼謂不行","color":"primary","size":15,"at":1},{"id":"t1_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"謂此而行不唯乎此則此謂不行其以當不","color":"primary","size":15,"at":1},{"id":"t1_3","kind":"text","x":0.5,"y":0.67,"label":"當也不當而亂也故彼彼當乎彼則唯乎彼","color":"primary","size":15,"at":1},{"id":"q2","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":2},{"id":"t2_0","kind":"text","x":0.5,"y":0.37,"label":"其謂行彼此此當乎此則唯乎此其謂行此","color":"primary","size":15,"at":2},{"id":"t2_1","kind":"text","x":0.5,"y":0.47,"label":"其以當而當也以當而當正也故彼彼止於","color":"primary","size":15,"at":2},{"id":"t2_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"彼此此止於此可彼此而彼且此此彼而此","color":"primary","size":15,"at":2},{"id":"t2_3","kind":"text","x":0.5,"y":0.67,"label":"且彼不可夫名實謂也知此之非此也知此","color":"primary","size":15,"at":2},{"id":"q3","kind":"box","x":0.08,"y":0.52,"w":0.008,"h":0.4,"color":"gold","at":3},{"id":"t3_0","kind":"text","x":0.5,"y":0.37,"label":"之不在此也則不謂也知彼之非彼也知彼","color":"primary","size":15,"at":3},{"id":"t3_1","kind":"text","x":0.5,"y":0.47,"label":"之不在彼也則不謂也至矣哉古之明王審","color":"primary","size":15,"at":3},{"id":"t3_2","kind":"text","x":0.5,"y":0.5700000000000001,"label":"其名實慎其所謂至矣哉古之明王公孫龍","color":"primary","size":15,"at":3},{"id":"t3_3","kind":"text","x":0.5,"y":0.67,"label":"子","color":"primary","size":15,"at":3},{"id":"k0","kind":"text","x":0.5,"y":0.52,"label":"天地與其所産焉物也夫物之為物以物其","color":"gold","size":17,"at":4}],"beats":[{"headline":"天地與其所産焉物也夫","dur":6},{"headline":"天地與其所産焉物也夫","dur":6,"hide":["t0_0","t0_1","t0_2","t0_3","q0"]},{"headline":"天地與其所産焉物也夫","dur":6,"hide":["t1_0","t1_1","t1_2","t1_3","q1"]},{"headline":"天地與其所産焉物也夫","dur":6,"hide":["t2_0","t2_1","t2_2","t2_3","q2"]},{"headline":"要点","dur":6.5,"hide":["t3_0","t3_1","t3_2","t3_3","q3"]}],"score":71}]}